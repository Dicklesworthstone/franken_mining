{
  "name": "frankenmining-website",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "bun src/wasm.ts",
    "build": "bun src/build.ts && pagefind --site out --quiet && bun src/check.ts",
    "test": "tsc && bun test src",
    "dev": "bun run build && wrangler dev",
    "stills": "bun src/stills.ts",
    "smoke": "bun src/smoke.ts",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "markdown-it": "15.0.3",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "@types/three": "0.180.0",
    "pagefind": "1.6.0",
    "playwright-core": "1.65.1",
    "typescript": "5.9.3",
    "wrangler": "4.166.0"
  }
}
