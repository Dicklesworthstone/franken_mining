% SYNTHETIC: each block alone violates one side of a two-sided blend window.
% Mining both at route 0 uses [0,0] and earns 10 - 3 = 7 in period 0.
% The loss-making partner cannot be discarded without breaking the blend.
NAME: complementary-two-sided-blend
TYPE: PCPSP
NBLOCKS: 2
NPERIODS: 2
NDESTINATIONS: 2
NRESOURCE_SIDE_CONSTRAINTS: 2
NGENERAL_SIDE_CONSTRAINTS: 0
DISCOUNT_RATE: 1
RESOURCE_CONSTRAINT_LIMITS:
0 0 L 0
0 1 L 0
1 0 L 0
1 1 L 0
OBJECTIVE_FUNCTION:
0 10 8
1 -3 -5
RESOURCE_CONSTRAINT_COEFFICIENTS:
0 0 0 2
0 1 0 3
1 0 0 -2
1 1 0 -3
0 0 1 -2
0 1 1 -3
1 0 1 2
1 1 1 3
EOF
